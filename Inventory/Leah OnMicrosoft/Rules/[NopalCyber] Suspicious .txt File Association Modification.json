    "last_modified": "2025-10-16T05:30:12.6721983Z",
    "name": "[NopalCyber] Suspicious .txt File Association Modification",
    "native_rule_id": "04ce2e0f-b94f-403b-bc5f-1230da90320d",
    "platform": "microsoft-sentinel",
    "severity": "Medium",
    "source": "Detection Platform inventory"
  },
  "native_rule": {
    "etag": "\"3000d95e-0000-0d00-0000-68f082e50000\"",
    "id": "/subscriptions/50792f69-0d5b-4f7c-a9e1-5de4e63f535a/resourceGroups/rg-security/providers/Microsoft.OperationalInsights/workspaces/law-security/providers/Microsoft.SecurityInsights/alertRules/04ce2e0f-b94f-403b-bc5f-1230da90320d",
    "kind": "Scheduled",
    "name": "04ce2e0f-b94f-403b-bc5f-1230da90320d",
    "properties": {
      "alertRuleTemplateName": null,
      "description": "Detects modifications to the default program associated with .txt files, specifically looking for changes to the 'open' command or 'UserChoice' registry keys. This can be indicative of an adversary attempting to establish persistence or execute malicious code when a user opens a text file.",
      "displayName": "[NopalCyber] Suspicious .txt File Association Modification",
      "enabled": true,
      "eventGroupingSettings": {
        "aggregationKind": "SingleAlert"
      },
      "incidentConfiguration": {
        "createIncident": true,
        "groupingConfiguration": {
          "enabled": false,
          "groupByAlertDetails": [],
          "groupByCustomDetails": [],
          "groupByEntities": [],
          "lookbackDuration": "PT5H",
          "matchingMethod": "AllEntities",
          "reopenClosedIncident": false
        }
      },
      "lastModifiedUtc": "2025-10-16T05:30:12.6721983Z",
      "query": "  DeviceRegistryEvents\r\n  | where ActionType ==\"RegistryValueSet\"\r\n  | where ((RegistryKey has_any (@\"\\txtfile\\shell\\open\\command\",@\"\\FileExts\\.txt\\UserChoice\") or RegistryKey endswith @\"\\.txt\"))\r\n  | where RegistryValueData !has \"notepad.exe\" // add notepad++.exe if used within the organisation",
      "queryFrequency": "PT1H",
      "queryPeriod": "P1D",
      "severity": "Medium",
      "suppressionDuration": "PT5H",
      "suppressionEnabled": false,
      "tactics": [
        "Persistence",
        "PrivilegeEscalation"
      ],
      "techniques": [
        "T1546"
      ],
      "triggerOperator": "GreaterThan",
      "triggerThreshold": 0
    },
    "type": "Microsoft.SecurityInsights/alertRules"
  }
}
