    "kind": "Scheduled",
    "name": "26268d60-c0bc-411b-96f2-425576074da3",
    "properties": {
      "alertRuleTemplateName": null,
      "description": "This rule is identifying if Defender Threat Inelligence Logs data source has stopped reporting to Sentinel in Last 3 days.",
      "displayName": "[NopalCyber] Data Connector Health Check -Microsoft Defender Threat Intelligence",
      "enabled": true,
      "entityMappings": [
        {
          "entityType": "Account",
          "fieldMappings": [
            {
              "columnName": "Dataconnector",
              "identifier": "FullName"
            }
          ]
        }
      ],
      "eventGroupingSettings": {
        "aggregationKind": "SingleAlert"
      },
      "incidentConfiguration": {
        "createIncident": true,
        "groupingConfiguration": {
          "enabled": false,
          "groupByAlertDetails": [],
          "groupByCustomDetails": [],
          "groupByEntities": [],
          "lookbackDuration": "PT5H",
          "matchingMethod": "AllEntities",
          "reopenClosedIncident": false
        }
      },
      "lastModifiedUtc": "2026-02-04T09:21:23.1601095Z",
      "query": "ThreatIntelIndicators \r\n| where TimeGenerated > ago(7d)\r\n| where SourceSystem in (\"Microsoft Defender Threat Intelligence\", \"Microsoft Emerging Threat Feed\")\r\n| extend Dataconnector = \"Microsoft Defender Threat Intelligence\"\r\n| summarize LastCall = max(TimeGenerated) by Type,Dataconnector\r\n| extend LogIngestionStatus = iff(LastCall < ago(3d), 'No', 'Yes')\r\n| where LogIngestionStatus == \"No\"",
      "queryFrequency": "P3D",
      "queryPeriod": "P7D",
      "severity": "Low",
      "suppressionDuration": "PT5H",
      "suppressionEnabled": false,
      "tactics": [
        "Impact"
