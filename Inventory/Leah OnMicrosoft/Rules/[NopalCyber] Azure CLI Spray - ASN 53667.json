    "properties": {
      "alertRuleTemplateName": null,
      "description": "This rule detects potential password spray attacks using the Microsoft Azure CLI client.\n\nThe detection focuses on:\n\nFailed login attempts with result codes:\n\n50126 → Invalid username or password\n\n50053 → Account locked due to repeated failures\n\nUserAgent = \"node-fetch\" → Indicates automated login attempts from scripted tools or CLI.\n\nASN = 53667 → This ASN is commonly associated with cloud-hosting services (e.g., Amazon / malicious infra).\n\nAppDisplayName = Microsoft Azure CLI → Ensures filtering only Azure CLI sign-ins.",
      "displayName": "[NopalCyber] Azure CLI Spray - ASN 53667",
      "enabled": true,
      "eventGroupingSettings": {
        "aggregationKind": "SingleAlert"
      },
      "incidentConfiguration": {
        "createIncident": true,
        "groupingConfiguration": {
          "enabled": false,
          "groupByAlertDetails": [],
          "groupByCustomDetails": [],
          "groupByEntities": [],
          "lookbackDuration": "PT5H",
          "matchingMethod": "AllEntities",
          "reopenClosedIncident": false
        }
      },
      "lastModifiedUtc": "2025-09-30T04:40:15.5084739Z",
      "query": "SigninLogs\r\n| where TimeGenerated > ago(30d)\r\n| where ResultType == \"50126\" or ResultType == \"50053\"\r\n| where UserAgent == \"node-fetch\"\r\n| where AutonomousSystemNumber == \"53667\"\r\n| where AppDisplayName == \"Microsoft Azure CLI\"",
      "queryFrequency": "P1D",
      "queryPeriod": "P1D",
      "severity": "Medium",
      "suppressionDuration": "PT5H",
