  "native_rule": {
    "etag": "\"2800409c-0000-0d00-0000-68eca7600000\"",
    "id": "/subscriptions/50792f69-0d5b-4f7c-a9e1-5de4e63f535a/resourceGroups/rg-security/providers/Microsoft.OperationalInsights/workspaces/law-security/providers/Microsoft.SecurityInsights/alertRules/5ab6b853-a151-46ad-917f-af979c424de5",
    "kind": "Scheduled",
    "name": "5ab6b853-a151-46ad-917f-af979c424de5",
    "properties": {
      "alertRuleTemplateName": null,
      "description": "This detection identifies potential activity associated with a known threat actor group’s unique sign-in signature observed within the last 90 days. The query looks for failed sign-in attempts (ResultType 50053 or 50126) to the OfficeHome application using a specific User-Agent string associated with malicious activity:\nMozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/116.0.\n\nThese conditions may indicate password spraying, credential stuffing, or unauthorized access attempts leveraging a threat actor’s tooling or infrastructure",
      "displayName": "[NopalCyber] New Threat Actor Group Signature",
      "enabled": true,
      "entityMappings": [
        {
          "entityType": "Account",
          "fieldMappings": [
            {
              "columnName": "AppDisplayName",
              "identifier": "FullName"
            },
            {
              "columnName": "UserPrincipalName",
              "identifier": "Name"
            }
          ]
        },
        {
          "entityType": "IP",
          "fieldMappings": [
            {
              "columnName": "IPAddress",
              "identifier": "Address"
            }
          ]
        }
      ],
      "eventGroupingSettings": {
        "aggregationKind": "SingleAlert"
      },
      "incidentConfiguration": {
        "createIncident": true,
        "groupingConfiguration": {
          "enabled": false,
          "groupByAlertDetails": [],
          "groupByCustomDetails": [],
          "groupByEntities": [],
          "lookbackDuration": "PT5H",
          "matchingMethod": "AllEntities",
          "reopenClosedIncident": false
        }
      },
      "lastModifiedUtc": "2025-10-13T07:16:48.1597191Z",
      "query": "SigninLogs\r\n| where TimeGenerated > ago(90d)\r\n| where ResultType == \"50053\" or ResultType == \"50126\"\r\n| where AppDisplayName == \"OfficeHome\"\r\n| where UserAgent == \"Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:109.0) Gecko/20100101 Firefox/116.0\"",
      "queryFrequency": "P1D",
      "queryPeriod": "P14D",
      "severity": "Medium",
      "suppressionDuration": "PT5H",
      "suppressionEnabled": false,
      "tactics": [
        "PrivilegeEscalation",
        "CredentialAccess",
        "CommandAndControl"
      ],
      "techniques": [
        "T1078",
        "T1110",
        "T1212",
        "T1071"
      ],
      "triggerOperator": "GreaterThan",
      "triggerThreshold": 0
    },
    "type": "Microsoft.SecurityInsights/alertRules"
  }
