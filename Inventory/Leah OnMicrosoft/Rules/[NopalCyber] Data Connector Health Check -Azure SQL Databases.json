    "kind": "Scheduled",
    "name": "f1022fc4-2678-4c06-ba94-8e731b64bd12",
    "properties": {
      "alertRuleTemplateName": null,
      "description": "This rule will identify if any Azure SQL stopped reporting to Sentinel in last 3 days.",
      "displayName": "[NopalCyber] Data Connector Health Check -Azure SQL Databases",
      "enabled": true,
      "entityMappings": [
        {
          "entityType": "Account",
          "fieldMappings": [
            {
              "columnName": "Dataconnector",
              "identifier": "FullName"
            }
          ]
        },
        {
          "entityType": "Host",
          "fieldMappings": [
            {
              "columnName": "Resource",
              "identifier": "FullName"
            }
          ]
        }
      ],
      "eventGroupingSettings": {
        "aggregationKind": "SingleAlert"
      },
      "incidentConfiguration": {
        "createIncident": true,
        "groupingConfiguration": {
          "enabled": false,
          "groupByAlertDetails": [],
          "groupByCustomDetails": [],
          "groupByEntities": [],
          "lookbackDuration": "PT5H",
          "matchingMethod": "AllEntities",
          "reopenClosedIncident": false
        }
      },
      "lastModifiedUtc": "2026-02-04T09:16:20.4447738Z",
      "query": "AzureDiagnostics\r\n| where TimeGenerated > ago(7d)\r\n| where ResourceProvider == \"MICROSOFT.SQL\"\r\n| extend Dataconnector = \"Azure SQL Databases\"\r\n| summarize LastCall = max(TimeGenerated) by Dataconnector, ResourceType, Resource\r\n| extend LogIngestionStatus = iff(LastCall < ago(3d), 'No', 'Yes')\r\n| where LogIngestionStatus == \"No\"",
      "queryFrequency": "P3D",
      "queryPeriod": "P7D",
      "severity": "Low",
      "suppressionDuration": "PT5H",
      "suppressionEnabled": false,
      "tactics": [
        "Impact"
      ],
      "techniques": [],
      "triggerOperator": "GreaterThan",
      "triggerThreshold": 0
    },
