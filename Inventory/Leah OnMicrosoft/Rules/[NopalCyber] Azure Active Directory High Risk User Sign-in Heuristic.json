      "query": "SigninLogs\n| where RiskState in (\"ConfirmedCompromise\", \"atRisk\")\n| where ResultSignature =~ \"Success\"\n| extend Country = parse_json(LocationDetails.countryOrRegion)\n| project UserPrincipalName, IPAddress, Country, AppDisplayName, AuthenticationRequirement",
