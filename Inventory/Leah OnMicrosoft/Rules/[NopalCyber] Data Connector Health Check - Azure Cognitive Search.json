    "id": "/subscriptions/50792f69-0d5b-4f7c-a9e1-5de4e63f535a/resourceGroups/rg-security/providers/Microsoft.OperationalInsights/workspaces/law-security/providers/Microsoft.SecurityInsights/alertRules/7b1c59f1-58a6-48c5-b2ee-4a969d8490db",
    "kind": "Scheduled",
    "name": "7b1c59f1-58a6-48c5-b2ee-4a969d8490db",
    "properties": {
      "alertRuleTemplateName": null,
      "description": "This rule will identify if any Azure Cognitive Search stopped reporting to Sentinel in last 7 days.",
      "displayName": "[NopalCyber] Data Connector Health Check - Azure Cognitive Search",
      "enabled": true,
      "entityMappings": [
        {
          "entityType": "Account",
          "fieldMappings": [
            {
              "columnName": "Dataconnector",
              "identifier": "FullName"
            }
          ]
        },
        {
          "entityType": "Host",
          "fieldMappings": [
            {
              "columnName": "Resource",
              "identifier": "FullName"
            }
          ]
        }
      ],
      "eventGroupingSettings": {
        "aggregationKind": "SingleAlert"
      },
      "incidentConfiguration": {
        "createIncident": true,
        "groupingConfiguration": {
          "enabled": false,
          "groupByAlertDetails": [],
          "groupByCustomDetails": [],
          "groupByEntities": [],
          "lookbackDuration": "PT5H",
          "matchingMethod": "AllEntities",
          "reopenClosedIncident": false
        }
      },
      "lastModifiedUtc": "2026-02-04T09:14:25.1967107Z",
      "query": "AzureDiagnostics\r\n| where TimeGenerated > ago(14d)\r\n| where ResourceProvider == \"MICROSOFT.SEARCH\"\r\n| extend Dataconnector = \"Azure Cognitive Search\"\r\n| summarize LastCall = max(TimeGenerated) by Dataconnector, ResourceType, Resource\r\n| extend LogIngestionStatus = iff(LastCall < ago(7d), 'No', 'Yes')\r\n| where LogIngestionStatus == \"No\"\r\n",
      "queryFrequency": "P7D",
      "queryPeriod": "P14D",
      "severity": "Low",
      "suppressionDuration": "PT5H",
      "suppressionEnabled": false,
      "tactics": [
        "Impact"
      ],
      "techniques": [],
      "triggerOperator": "GreaterThan",
      "triggerThreshold": 0
    },
