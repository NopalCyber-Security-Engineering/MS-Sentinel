      "lastModifiedUtc": "2026-02-04T09:31:40.0076491Z",
      "query": "AzureDiagnostics\n| where TimeGenerated > ago(7d)\n| where ResourceProvider == \"MICROSOFT.KEYVAULT\"\n| extend Dataconnector = \"Azure Key Vault\"\n| summarize LastCall = max(TimeGenerated) by Dataconnector, ResourceType, Resource\n| extend LogIngestionStatus = iff(LastCall < ago(3d), 'No', 'Yes')\n| where LogIngestionStatus == \"No\"\n",
