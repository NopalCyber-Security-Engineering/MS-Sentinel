    "properties": {
      "alertRuleTemplateName": null,
      "description": "This rule will identify if any Azure Firewall resource logs stopped reporting to Sentinel in last 3 days.",
      "displayName": "[NopalCyber] Data Connector Health Check - Azure Key Vault",
