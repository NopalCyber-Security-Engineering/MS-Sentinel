    "kind": "Scheduled",
    "name": "de6671ff-edae-4df2-a7ff-b5ba0e3585fb",
    "properties": {
      "alertRuleTemplateName": null,
      "description": "This rule check for unique IPs from all graph activities and determine if these IPs matches against any threat indicator IPs in your TAXII feed.",
      "displayName": "[NopalCyber] Defending malicious MS graph activity with MS Sentinel Threat Intelligence",
      "enabled": true,
