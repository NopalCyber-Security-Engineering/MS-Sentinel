      },
      "lastModifiedUtc": "2026-05-14T12:20:16.0469747Z",
      "query": "union isfuzzy=true\r\n    (SentinelOneActivities_CL\r\n    | where TimeGenerated > ago(7d)\r\n    | summarize LastCall1 = max(TimeGenerated) by Type),\r\n    (SentinelOneAgents_CL\r\n    | where TimeGenerated > ago(7d)\r\n    | summarize LastCall1 = max(TimeGenerated) by Type),\r\n    (SentinelOneThreats_CL\r\n    | where TimeGenerated > ago(7d)\r\n    | summarize LastCall1 = max(TimeGenerated) by Type),\r\n    (SentinelOneAlerts_CL\r\n    | where TimeGenerated > ago(7d)\r\n    | summarize LastCall1 = max(TimeGenerated) by Type)\r\n| extend Dataconnector = \"SentinelOne\"\r\n| summarize LastCall = max(LastCall1) by Dataconnector, Type\r\n| extend LogIngestionStatus = iff(LastCall < ago(3d), 'No', 'Yes')\r\n| where LogIngestionStatus == \"No\"\r\n",
      "queryFrequency": "P3D",
