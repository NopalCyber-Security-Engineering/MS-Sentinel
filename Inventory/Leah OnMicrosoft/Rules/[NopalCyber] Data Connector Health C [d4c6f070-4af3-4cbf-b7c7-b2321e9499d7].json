    "properties": {
      "alertRuleTemplateName": null,
      "description": "This rule monitors Windows virtual machines that have stopped sending Heartbeat signals to Microsoft Sentinel for over 24 hours.",
      "displayName": "[NopalCyber] Data Connector Health Check -Windows Server (Heartbeat Missing)",
      "enabled": true,
      "entityMappings": [
        {
          "entityType": "Host",
          "fieldMappings": [
            {
              "columnName": "Resource",
              "identifier": "FullName"
            }
          ]
        }
      ],
      "eventGroupingSettings": {
        "aggregationKind": "SingleAlert"
      },
      "incidentConfiguration": {
        "createIncident": true,
        "groupingConfiguration": {
          "enabled": true,
          "groupByAlertDetails": [],
          "groupByCustomDetails": [],
          "groupByEntities": [],
          "lookbackDuration": "P3D",
          "matchingMethod": "AllEntities",
          "reopenClosedIncident": false
        }
      },
      "lastModifiedUtc": "2026-06-04T04:37:11.3563089Z",
      "query": "Heartbeat\r\n| where TimeGenerated > ago(3d)\r\n| where OSType == \"Windows\"\r\n| where ResourceType == \"virtualMachines\"\r\n| summarize LastCall = max(TimeGenerated) by Resource, ResourceType, OSType, OSName\r\n| extend LogIngestionStatus = iff(LastCall < ago(1d), 'No', 'Yes')\r\n| where LogIngestionStatus == \"No\"\r\n",
      "queryFrequency": "P1D",
      "queryPeriod": "P3D",
