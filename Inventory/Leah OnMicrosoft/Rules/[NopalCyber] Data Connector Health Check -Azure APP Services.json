    "properties": {
      "alertRuleTemplateName": null,
      "description": "This rule will identify if any App Service stopped reporting to Sentinel in last 3 days.",
      "displayName": "[NopalCyber] Data Connector Health Check -Azure APP Services",
      "enabled": true,
      "entityMappings": [
        {
          "entityType": "Account",
          "fieldMappings": [
            {
              "columnName": "Dataconnector",
              "identifier": "FullName"
            }
          ]
