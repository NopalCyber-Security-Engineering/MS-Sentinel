    "id": "/subscriptions/50792f69-0d5b-4f7c-a9e1-5de4e63f535a/resourceGroups/rg-security/providers/Microsoft.OperationalInsights/workspaces/law-security/providers/Microsoft.SecurityInsights/alertRules/7a93e4d6-14c0-4489-a2b6-31978dd577e5",
    "kind": "Scheduled",
    "name": "7a93e4d6-14c0-4489-a2b6-31978dd577e5",
    "properties": {
      "alertRuleTemplateName": null,
      "description": "Azure Activity will have subscription (Resource) wise activity events. This rule is identifying if any Subscription (resource) activity logs not seen in last 3 days",
      "displayName": "[NopalCyber] Data Connector Health Check - Azure Activity",
      "enabled": true,
      "entityMappings": [
        {
          "entityType": "Account",
          "fieldMappings": [
            {
              "columnName": "Dataconnector",
              "identifier": "FullName"
            }
          ]
        },
        {
          "entityType": "Account",
          "fieldMappings": [
            {
              "columnName": "SubscriptionId",
              "identifier": "FullName"
            }
          ]
        }
      ],
      "eventGroupingSettings": {
        "aggregationKind": "SingleAlert"
      },
      "incidentConfiguration": {
        "createIncident": true,
        "groupingConfiguration": {
          "enabled": false,
          "groupByAlertDetails": [],
          "groupByCustomDetails": [],
          "groupByEntities": [],
          "lookbackDuration": "PT5H",
          "matchingMethod": "AllEntities",
          "reopenClosedIncident": false
        }
      },
      "lastModifiedUtc": "2026-02-04T09:32:29.2947106Z",
      "query": "AzureActivity\n| where TimeGenerated > ago(7d)\n| extend Dataconnector = \"Azure Activity\"\n| summarize LastCall = max(TimeGenerated) by Dataconnector, SubscriptionId\n| extend LogIngestionStatus = iff(LastCall < ago(3d), 'No', 'Yes')\n| where LogIngestionStatus == \"No\"\n",
      "queryFrequency": "P3D",
      "queryPeriod": "P7D",
      "severity": "Medium",
      "suppressionDuration": "PT5H",
      "suppressionEnabled": false,
      "tactics": [
        "Impact"
      ],
